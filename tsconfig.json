{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["apps/daemon/**/*.ts", "crates/node/*.ts", "scripts/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
